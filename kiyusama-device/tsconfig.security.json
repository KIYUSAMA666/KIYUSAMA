{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "outDir": "dist/security",
    "rootDir": "packages/security/src",
    "declaration": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["packages/security/src/**/*.ts"]
}
