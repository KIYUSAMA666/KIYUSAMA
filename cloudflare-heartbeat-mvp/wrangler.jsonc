{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-heartbeat-mvp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "HeartbeatAgent", "class_name": "HeartbeatAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HeartbeatAgent"] }
  ]
}
